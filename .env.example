# ── Flip7 Docker Stack Configuration ──
# Copy this file to .env and adjust values before deploying.

# PostgreSQL password
DB_PASSWORD=Testflip7!

# JWT signing secret (change this in production!)
JWT_SECRET=change-me_change-me_change-me_change-me_change-me

# Port exposed by nginx on the host (your Portainer reverse proxy points here)
APP_PORT=8080
